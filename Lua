	new("UICorner", { CornerRadius = UDim.new(0, 4) }, box)
	new("UIStroke", { Color = Color3.fromRGB(235, 25, 25), Thickness = 2 }, box)

	local status = new("TextLabel", {
		Position = UDim2.fromOffset(10, 68),
		Size = UDim2.new(1, -20, 0, 16),
		BackgroundTransparency = 1,
		Text = "",
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.fromRGB(255, 60, 60),
	}, body)

	local submit = new("TextButton", {
		Position = UDim2.fromOffset(10, 88),
		Size = UDim2.new(1, -20, 0, 24),
		BackgroundColor3 = Color3.fromRGB(235, 25, 25),
		BorderSizePixel = 0,
		Text = "SUBMIT",
		Font = Enum.Font.GothamBlack,
		TextSize = 15,
		TextColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = true,
	}, body)
	new("UICorner", { CornerRadius = UDim.new(0, 4) }, submit)

	local function trySubmit()
		if unlocked then return end
		local txt = box.Text:gsub("^%s+", ""):gsub("%s+$", "")
		local a, b = txt, KEY
		if not CASE_SENSITIVE then a, b = a:upper(), b:upper() end
		if a == b then
			status.TextColor3 = Color3.fromRGB(60, 255, 90)
			status.Text = "ACCESS GRANTED"
			unlock()
		else
			status.TextColor3 = Color3.fromRGB(255, 60, 60)
			status.Text = "KEY ผิด ลองใหม่"
			local p = win.Position
			for i = 1, 4 do
				win.Position = p + UDim2.fromOffset(i % 2 == 0 and 8 or -8, 0)
				task.wait(0.04)
			end
			win.Position = p
		end
	end
	submit.MouseButton1Click:Connect(trySubmit)
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then trySubmit() end
	end)
end

