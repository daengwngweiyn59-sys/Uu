local function buildGoreBox()
	-- ===== เพลง =====
	local music = new("Sound", {
		Name = "GoreBoxMusic",
		SoundId = "rbxassetid://" .. tostring(MUSIC_ID),
		Looped = true,
		Volume = MUSIC_VOLUME,
	}, SoundService)
	music:Play()
	task.delay(8, function()
		if not music.IsLoaded then
			warn("[GoreBoxUI] โหลดเพลงไม่ขึ้น: " .. music.SoundId)
		end
	end)

	-- ===== ข้อความต้อนรับ =====
	local welcome = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.new(0.9, 0, 0, 60),
		BackgroundTransparency = 1,
		Text = WELCOME,
		Font = Enum.Font.GothamMedium,
		TextScaled = true,
		TextColor3 = Color3.new(1, 1, 1),
		TextTransparency = 1,
		ZIndex = 10,
	}, gui)
	new("UITextSizeConstraint", { MaxTextSize = 34 }, welcome)
	local welcomeStroke = new("UIStroke", { Color = BLACK, Thickness = 2, Transparency = 1 }, welcome)

	-- ===== ดาวสีน้ำเงิน =====
	local STAR_R = 95
	local starHolder = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(STAR_R * 2, STAR_R * 2),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 10,
	}, gui)
	local starScale = new("UIScale", { Scale = 0 }, starHolder)

	do
		local R, r, rowH = STAR_R, STAR_R * 0.47, 2
		local pts = {}
		for i = 0, 9 do
			local ang = math.rad(-90 + i * 36)
			local rad = (i % 2 == 0) and R or r
			pts[#pts + 1] = Vector2.new(R + rad * math.cos(ang), R + rad * math.sin(ang))
		end
		local y = 0
		while y < R * 2 do
			local yc = y + rowH / 2
			local xs = {}
			for i = 1, #pts do
				local a, b = pts[i], pts[i % #pts + 1]
				if (a.Y <= yc and b.Y > yc) or (b.Y <= yc and a.Y > yc) then
					local t = (yc - a.Y) / (b.Y - a.Y)
					xs[#xs + 1] = a.X + t * (b.X - a.X)
				end
			end
			table.sort(xs)
			for k = 1, #xs - 1, 2 do
				new("Frame", {
					Position = UDim2.fromOffset(xs[k], y),
					Size = UDim2.fromOffset(xs[k + 1] - xs[k], rowH + 0.5),
					BackgroundColor3 = STAR_COLOR,
					BorderSizePixel = 0,
				}, starHolder)
			end
			y += rowH
		end
	end

	-- ===== สี่เหลี่ยมดำขอบม่วงชมพู =====
	local sq = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 20,
	}, gui)
	new("UIStroke", { Color = MAGENTA, Thickness = 5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, sq)

	-- ===== กล่อง UI หลัก =====
	local main = new("Frame", {
		Name = "Main",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(0, 0),
		BackgroundColor3 = BLACK,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Visible = false,
		ZIndex = 30,
	}, gui)
	new("UICorner", { CornerRadius = UDim.new(0, 6) }, main)
	new("UIStroke", { Color = MAGENTA, Thickness = 4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, main)
	local fitScale = new("UIScale", { Scale = 1 }, main)

	local function fit()
		local cam = workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		fitScale.Scale = math.clamp(math.min(1, vp.Y * 0.75 / BOX_H, vp.X * 0.9 / BOX_W), 0.5, 1)
	end
