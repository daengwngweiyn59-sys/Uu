	for r = 0, rows - 1 do
		for c = 0, cols - 1 do
			cells[#cells + 1] = new("Frame", {
				Position = UDim2.fromScale(c / cols, r / rows),
				Size = UDim2.fromScale(1 / cols + 0.01, 1 / rows + 0.01),
				BackgroundColor3 = GLITCH_COLORS[rng:NextInteger(1, #GLITCH_COLORS)],
				BorderSizePixel = 0,
			}, body)
		end
	end
	return cells
end

